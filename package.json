{
  "name": "@59alex/file-streams-react",
  "version": "0.1.0",
  "description": "React file transfers with streamed bytes, explicit commit state and owned cancellation",
  "type": "module",
  "license": "MIT",
  "author": "Aleksandr Kashevarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlorian59/file-streams-react.git"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "assets",
    "examples/attachments"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react19": {
      "types": "./dist/react19.d.ts",
      "import": "./dist/react19.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@59alex/file-streams": "^0.1.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@59alex/file-streams": "file:../file-streams/browser",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "jsdom": "27.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
